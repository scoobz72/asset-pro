# Asset Pro production settings - copy to ~/assetpro/.env on the server
# (chmod 600 .env). Never commit the real .env file.

NODE_ENV=production
PORT=5100
# Only nginx talks to the app, so keep it off the public network
HOST=127.0.0.1
APP_URL=https://mycmms.co.uk

# Database (local PostgreSQL on the server)
DATABASE_URL=postgresql://assetpro:YOUR_DB_PASSWORD@localhost:5432/assetpro

# Long random string - generate with:  openssl rand -hex 32
SESSION_SECRET=

# Platform admin (you). On first start, if no platform admin exists, the app creates
# the "MyCMMS HQ" company and this account. Remove the password line once you can sign in.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_BOOTSTRAP_PASSWORD=
# PLATFORM_COMPANY_NAME=MyCMMS HQ
